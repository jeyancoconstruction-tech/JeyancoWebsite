APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Outgoing email. The only message this system sends is the password reset
# link, so these settings are what make "Forgot password" work at all.
#
# MAIL_MAILER=log is Laravel's default and it sends NOTHING: every message is
# written to storage/logs/laravel.log while the app reports success, so the
# reset form says a link is on its way and no inbox ever receives one. Leave
# it as `log` for local work; on Railway it must be `smtp`.
#
# Gmail: MAIL_PASSWORD is a 16-character App Password, not the account
# password. Create one at Google Account > Security > App passwords, which
# only appears once 2-Step Verification is on.
#   smtp.gmail.com  port 587  MAIL_SCHEME=smtp
#
# MAIL_SCHEME takes `smtp` or `smtps` and nothing else: Symfony Mailer throws
# UnsupportedSchemeException on anything it does not recognise, so the `tls`
# that Laravel 10 wanted under the old MAIL_ENCRYPTION key breaks sending
# outright. On port 587 `smtp` negotiates STARTTLS by itself; `smtps` is for
# port 465, which is encrypted from the first byte.
#
# After changing these, prove they work without going through the form:
#   php artisan mail:test someone@example.com
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Google Maps JavaScript API key — enables the site location picker
# (autocomplete + draggable pin). Enable "Maps JavaScript API",
# "Places API" and "Geocoding API" in Google Cloud, then paste the key here.
GOOGLE_MAPS_API_KEY=

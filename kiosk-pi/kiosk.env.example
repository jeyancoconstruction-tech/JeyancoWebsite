# Jeyanco kiosk — settings of THIS Pi. Copy to /home/admin/jeyanco/kiosk.env
# (setup.sh does it) and fill in. Read by the fingerprint service (systemd
# EnvironmentFile=) and by start-kiosk.sh.

# The web on Railway. The kiosk screen is <JEYANCO_WEB>/kiosk
JEYANCO_WEB=https://jeyancowebsite-production.up.railway.app

# Which kiosk this Pi is. Must match a code in System Settings → Kiosks.
# A second Pi gets its own code (add it there first: "Add kiosk").
JEYANCO_KIOSK_CODE=SITE_A

# The secret shared with the web. Must be EXACTLY the same as
# KIOSK_DEVICE_KEY in Railway → Variables. Make one with:  openssl rand -hex 32
JEYANCO_DEVICE_KEY=

# R307 on the Pi's UART (GPIO14/15). The GPS uses /dev/ttyAMA3.
JEYANCO_SERIAL=/dev/serial0
JEYANCO_BAUD=57600

# Raise (e.g. 50) if the sensor ever accepts the wrong finger. 0 = as before.
JEYANCO_MIN_CONFIDENCE=0

# Optional: more web addresses allowed to use the sensor (comma separated),
# e.g. a custom domain. JEYANCO_WEB is always allowed.
# JEYANCO_ALLOWED_ORIGINS=https://jeyancowebsite-production.up.railway.app,https://kiosk.jeyanco.com
